{
  "name": "vitrine-mode-brazzaville",
  "version": "0.1.0",
  "private": true,
  "description": "Vitrine mode immersive — Brazzaville (Congo)",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
